# ==============================================================================
# AI Knowledge Platform - Environment Variables Template
# ==============================================================================
# COPY THIS FILE TO '.env' AND FILL IN YOUR SECRETS:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configurations
# ------------------------------------------------------------------------------
# Local development default:
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# ------------------------------------------------------------------------------
# 2. Security & CORS Configurations
# ------------------------------------------------------------------------------
# Comma-separated allowed frontend domains.
# Local development default: "http://localhost:3000"
# Production example: "https://my-app.vercel.app,http://localhost:3000"
ALLOWED_ORIGINS=http://localhost:3000

# Secret used to SIGN JWT access tokens. Anyone holding it can forge a token
# for any user, so treat it like a password. Generate one with:
#   openssl rand -hex 32
# Never commit the real value, never reuse it across environments.
# In production this is injected via GitHub Secrets -> Cloud Run env vars.
JWT_SECRET=replace_me_with_openssl_rand_hex_32

# How long an ACCESS token stays valid, in minutes (default: 15).
# Day 10 two-token model: access tokens are deliberately SHORT (theft window).
# Long-lived sessions come from the refresh token (REFRESH_TOKEN_EXPIRE_DAYS, default 7),
# which is revocable - so we never need long-lived access tokens.
JWT_EXPIRE_MINUTES=15

# How long a REFRESH token stays valid, in days (default: 7).
# Refresh tokens are stateful (rows in Postgres) and revocable - that is what
# makes real logout possible.
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 3. AI / LLM Configurations (Phase 3 Integration)
# ------------------------------------------------------------------------------
# Your Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
